APP_NAME="undangan-digital.link"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

FRONTEND_URL=http://localhost:3000
SANCTUM_STATEFUL_DOMAINS=localhost:3000
SESSION_DOMAIN=localhost

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=undangan_digital
DB_USERNAME=undangan_app
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=r2
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@undangan-digital.link"
MAIL_FROM_NAME="${APP_NAME}"

# --- AI (Claude) ---
# Never exposed to the frontend. Read only by the backend.
AI_PROVIDER=claude
CLAUDE_API_KEY=
CLAUDE_MODEL=claude-sonnet-5
CLAUDE_API_BASE_URL=https://api.anthropic.com
CLAUDE_TIMEOUT_SECONDS=30
CLAUDE_MAX_RETRIES=1
AI_MAX_INPUT_CHARS=4000
AI_MAX_OUTPUT_TOKENS=1024
AI_RATE_LIMIT_MAX_ATTEMPTS=20
AI_RATE_LIMIT_DECAY_MINUTES=60

# --- S3-compatible storage (Cloudflare R2 by default) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
AWS_BUCKET=undangan-digital-media
AWS_USE_PATH_STYLE_ENDPOINT=true
AWS_ENDPOINT=
AWS_URL=

VITE_APP_NAME="${APP_NAME}"
